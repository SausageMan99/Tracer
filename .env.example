# Public browser-side Mapbox token. Safe to expose; should start with pk.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server-side routing providers.
GRAPHHOPPER_API_KEY=
ORS_API_KEY=

# Optional admin export secret for GET /api/feedback.
# Generate with: openssl rand -hex 32
ADMIN_SECRET=***

# Optional salt for privacy-preserving IP hashes in feedback telemetry.
# Generate with: openssl rand -hex 32
PRIVACY_HASH_SALT=***

# Optional feature flags / GrowthBook integration.
# Leave empty locally: the app builds without precomputed flag permutations.
GROWTHBOOK_API_HOST=https://cdn.growthbook.io
GROWTHBOOK_CLIENT_KEY=
# Generate with: openssl rand -hex 32
FLAGS_SECRET=
